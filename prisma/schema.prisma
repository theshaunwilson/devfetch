// DevFetch database schema
// Prisma 7 — the `prisma-client` generator requires an explicit `output`.
// Connection settings live in prisma.config.ts, not in this file.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ---------------------------------------------------------------------------
// Auth (NextAuth v5 / Auth.js Prisma adapter)
// ---------------------------------------------------------------------------

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String    @unique
  emailVerified DateTime?
  image         String?
  // Null for OAuth-only users
  password      String?

  // The code editor's font size, tab size, theme and toggles. JSON rather than
  // five columns: they are one set, always read and written together, and
  // nothing queries or sorts on any of them. Nullable means "never set" — the
  // defaults live in `src/lib/editor-preferences.ts` and are applied on read,
  // so no row has to be written for an account to have working preferences.
  //
  // Postgres constrains nothing about the shape, so every read goes through
  // `parseEditorPreferences` rather than being trusted.
  editorPreferences Json?

  isPro                Boolean @default(false)
  stripeCustomerId     String? @unique
  stripeSubscriptionId String? @unique

  accounts    Account[]
  sessions    Session[]
  items       Item[]
  itemTypes   ItemType[]
  collections Collection[]
  tags        Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@unique([identifier, token])
  @@index([expires])
}

// ---------------------------------------------------------------------------
// DevFetch domain
// ---------------------------------------------------------------------------

model Item {
  id          String  @id @default(cuid())
  title       String
  // "text" | "file"
  contentType String  @default("text")
  // Used by text types
  content     String?
  fileUrl     String?
  fileName    String?
  fileSize    Int?
  url         String?
  description String?
  isFavorite  Boolean @default(false)
  isPinned    Boolean @default(false)
  language    String?

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  typeId String
  // Types are never deleted out from under their items
  type   ItemType @relation(fields: [typeId], references: [id], onDelete: Restrict)

  // An item can be filed in any number of collections, including none
  collections ItemCollection[]

  tags ItemTag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([userId, createdAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, isPinned])
  @@index([userId, isFavorite])
  @@index([userId, typeId])
  @@index([typeId])
}

model ItemType {
  id       String  @id @default(cuid())
  name     String
  slug     String
  icon     String?
  color    String?
  isSystem Boolean @default(false)

  // Null for the built-in system types, set for Pro custom types
  userId String?
  user   User?   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items Item[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, slug])
  @@index([userId])
}

model Collection {
  id          String  @id @default(cuid())
  name        String
  description String?
  color       String?
  isFavorite  Boolean @default(false)

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemCollection[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, name])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, isFavorite])
}

// Items filed in collections. Many-to-many: an item can sit in several
// collections and a collection holds many items. Shaped like ItemTag, and
// cascading from both sides — a deleted item leaves no join rows behind, and
// deleting a collection unfiles its items rather than deleting them.
model ItemCollection {
  itemId       String
  collectionId String

  item       Item       @relation(fields: [itemId], references: [id], onDelete: Cascade)
  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())

  @@id([itemId, collectionId])
  // The item side is covered by the primary key; this is for reads that start
  // from a collection, which is every dashboard and sidebar count.
  @@index([collectionId])
}

model Tag {
  id   String @id @default(cuid())
  name String

  userId String
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  items ItemTag[]

  createdAt DateTime @default(now())

  @@unique([userId, name])
  @@index([userId])
}

model ItemTag {
  itemId String
  tagId  String

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  tag  Tag  @relation(fields: [tagId], references: [id], onDelete: Cascade)

  @@id([itemId, tagId])
  @@index([tagId])
}
