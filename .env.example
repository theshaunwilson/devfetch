# Neon PostgreSQL — development branch. Copy to .env.local and fill in.
# Production uses its own Neon branch's connection strings.

# Pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct endpoint (same host without "-pooler") — used by Prisma Migrate,
# which needs advisory locks that Neon's PgBouncer pooler does not support.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js / NextAuth v5. Generate a secret with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app. Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Resend. Verification emails are sent from here.
RESEND_API_KEY=""

# Sender address. Until a domain is verified at resend.com/domains, this must
# stay the shared testing sender, which only delivers to the Resend account's
# own address — any other recipient is rejected with a 403.
EMAIL_FROM="DevFetch <onboarding@resend.dev>"

# Absolute base for links in emails. Set to the deployed origin in production.
APP_URL="http://localhost:3000"
