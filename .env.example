# Neon PostgreSQL — development branch. Copy to .env.local and fill in.
# Production uses its own Neon branch's connection strings.

# Pooled endpoint (host contains "-pooler") — used by the app at runtime.
DATABASE_URL="postgresql://USER:PASSWORD@HOST-pooler.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Direct endpoint (same host without "-pooler") — used by Prisma Migrate,
# which needs advisory locks that Neon's PgBouncer pooler does not support.
DIRECT_DATABASE_URL="postgresql://USER:PASSWORD@HOST.REGION.aws.neon.tech/neondb?sslmode=require&channel_binding=require"

# Auth.js / NextAuth v5. Generate a secret with `npx auth secret`.
AUTH_SECRET=""

# GitHub OAuth app. Callback URL: http://localhost:3000/api/auth/callback/github
AUTH_GITHUB_ID=""
AUTH_GITHUB_SECRET=""

# Email verification. Registration issues a link and credentials sign-in is
# refused until it is clicked. Only the literal "off" (any case, trimmed)
# skips both — accounts are then created already verified, and accounts left
# unverified can still sign in.
#
# Left unset on purpose: anything that is not "off" leaves verification on, so
# a deployment that never sets it fails secure. Do not fill this in for
# production.
#
# Uncomment it locally while Resend has no verified domain — until one is
# added, only the Resend account's own address can receive mail, so any other
# registration would create an account nobody can reach.
# EMAIL_VERIFICATION="off"

# Resend. Verification emails are sent from here.
RESEND_API_KEY=""

# Sender address. Until a domain is verified at resend.com/domains, this must
# stay the shared testing sender, which only delivers to the Resend account's
# own address — any other recipient is rejected with a 403.
EMAIL_FROM="DevFetch <onboarding@resend.dev>"

# Absolute base for links in emails. Set to the deployed origin in production.
APP_URL="http://localhost:3000"

# Upstash Redis — rate limiting on the auth endpoints (sign in, register,
# forgot password, reset password, resend verification). Create a database at
# console.upstash.com and copy its REST credentials.
#
# Rate limiting FAILS OPEN: with either of these unset, or with Upstash
# unreachable, requests are allowed through rather than refused, so an outage
# cannot lock every user out of their own account. That is the opposite of the
# EMAIL_VERIFICATION default above, and deliberate — but it does mean an
# unconfigured deployment has no limiting at all. The server logs a warning
# once at startup when that is the case; do not ignore it in production.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""
# Cloudflare R2 Storage
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME=""
R2_PUBLIC_URL=""

# Stripe. Test-mode secret key from dashboard.stripe.com/test/apikeys. Never
# the publishable key — hosted Checkout is a redirect, so Stripe.js never loads
# in the browser and there is nothing for it to do.
STRIPE_SECRET_KEY=""

# Signing secret for POST /api/stripe/webhook. In development this is printed
# by `stripe listen --forward-to localhost:3000/api/stripe/webhook` and is NOT
# the same secret the Dashboard shows for a deployed endpoint — they are not
# interchangeable. Unset, the webhook refuses every request with a 500 rather
# than trusting an unverified body.
STRIPE_WEBHOOK_SECRET=""

# The two recurring prices on the one DevFetch Pro product: $8/month and
# $72/year. Two prices on one product, not two products — that is what lets
# the billing portal offer a switch between them.
STRIPE_PRICE_ID_MONTHLY=""
STRIPE_PRICE_ID_YEARLY=""
